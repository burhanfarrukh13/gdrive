# Copy this file to .env and fill values
APP_SECRET=change-me-to-a-random-64-char-string
APP_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./data/app.db

# Google Service Account (drop the downloaded JSON into secrets/service_account.json)
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service_account.json
# Optional: set this if you want to restrict the app to a single Google Workspace domain
# GOOGLE_WORKSPACE_DOMAIN=example.com

# Bootstrap admin — only used the very first time the app starts against an
# empty database (creates this one "owner" account, then never read again).
# Set your own values before first run; don't leave these as defaults.
BOOTSTRAP_ADMIN_EMAIL=admin@yourcompany.local
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-first-run
BOOTSTRAP_ADMIN_NAME=Owner